<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- Cấu hình chuỗi kết nối cơ sở dữ liệu SQL Server -->
	<configSections>
	</configSections>
	<connectionStrings>
		<add name="CoffeeShopDB"
			 connectionString="Data Source=.\MSSQLSERVER01;Initial Catalog=CoffeeShopDB;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="DoAnCuoiKi_QuanLyTiemCaPhe.Properties.Settings.CoffeeShopDBConnectionString"
			 connectionString="Data Source=.\MSSQLSERVER01;Initial Catalog=CoffeeShopDB;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- Cấu hình các thông số chung của quán (dùng cho in hóa đơn, tiêu đề, VAT) -->
	<appSettings>
		<add key="ShopName" value="The Coffee House" />
		<add key="ShopAddress" value="123 Nguyễn Huệ, Q.1, TP.HCM" />
		<add key="ShopPhone" value="0909123456" />
		<add key="VATPercent" value="8" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>