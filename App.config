<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Cấu hình chuỗi kết nối cơ sở dữ liệu SQL Server -->
	<configSections>
	</configSections>
	<connectionStrings>
		<add name="CoffeeShopDB" connectionString="Data Source=.;Initial Catalog=CoffeeShopDB;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
		<add name="DoAnCuoiKi_QuanLyTiemCaPhe.Properties.Settings.CoffeeShopDBConnectionString" connectionString="Data Source=.;Initial Catalog=CoffeeShopDB;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
		<add name="DoAnCuoiKi_QuanLyTiemCaPhe.Properties.Settings.CoffeeShopDBConnectionString1" connectionString="Data Source=localhost;Initial Catalog=CoffeeShopDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- Cấu hình các thông số chung của quán (dùng cho in hóa đơn, tiêu đề, VAT, Wifi) -->
	<appSettings>
		<add key="ShopName" value="Mộc Cafe POS" />
		<add key="ShopAddress" value="123 Nguyễn Huệ, Q.1, TP.HCM" />
		<add key="ShopPhone" value="0909 123 456" />
		<add key="VATPercent" value="8" />
		<add key="VATRate" value="8" />
		<add key="WifiInfo" value="MocCafe_Free | Pass: moccafe2026" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="EPPlus.Interfaces" publicKeyToken="a694d7f3b0907a61" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.6.2.0" newVersion="8.6.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IO.RecyclableMemoryStream" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.0" newVersion="4.0.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
